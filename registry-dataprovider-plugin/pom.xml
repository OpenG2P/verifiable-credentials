<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.openg2p.certify</groupId>
    <artifactId>registry-dataprovider-plugin</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>registry-dataprovider-plugin</name>
    <description>Inji Certify DataProvider plugin that fetches VC claims from an external
        OpenG2P Registry database via configurable, scope-based SQL queries with a configurable
        token-claim → query-parameter binding.</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <!-- versions aligned to Inji Certify 0.14.0 (Spring Boot 3.2.3 / Spring 6.1.4) -->
        <certify.version>0.14.0</certify.version>
        <spring.version>6.1.4</spring.version>
        <spring.boot.version>3.2.3</spring.boot.version>
    </properties>

    <!-- All dependencies are 'provided' — they are already on the Inji Certify runtime
         classpath. The built JAR therefore contains ONLY this plugin's classes and is
         dropped into Certify's loader_path. This avoids any library version clashes. -->
    <dependencies>
        <dependency>
            <groupId>io.inji.certify</groupId>
            <artifactId>certify-integration-api</artifactId>
            <version>${certify.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.inji.certify</groupId>
            <artifactId>certify-core</artifactId>
            <version>${certify.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.json</groupId>
            <artifactId>json</artifactId>
            <version>20240303</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
            <version>${spring.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-jdbc</artifactId>
            <version>${spring.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot</artifactId>
            <version>${spring.boot.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
            <version>${spring.boot.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.12</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.12</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>registry-dataprovider-plugin</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
        </plugins>
    </build>
</project>
